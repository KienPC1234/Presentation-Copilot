# Ollama LLM settings
# Local (uvicorn) endpoint:
OLLAMA_BASE_URL=http://localhost:11434
# Docker only: endpoint the container uses for Ollama. Default below is the
# bundled compose service. Use http://host.docker.internal:11434 to reach an
# Ollama running directly on the host machine.
OLLAMA_URL=http://ollama:11434
# Optional dedicated embedding endpoint; empty uses OLLAMA_BASE_URL.
OLLAMA_EMBEDDING_BASE_URL=
OLLAMA_EMBEDDING_URL=
OLLAMA_MODEL=qwen2.5:7b
# Optional separate final-answer/reviewer models; empty uses the main model.
OLLAMA_ANSWER_MODEL=
OLLAMA_REVIEW_MODEL=
# Per provider call, not an end-to-end request deadline.
LLM_TIMEOUT_SECONDS=45
# JSON calls request final content without reasoning output. Disable if a model
# cannot accept think=false; validate that model before using it in a meeting.
OLLAMA_JSON_DISABLE_THINKING=true
# Adult audience; "plain" uses everyday words, "technical" keeps expert terminology.
RESPONSE_STYLE=plain

# Whisper STT settings
# GPU (this project's Docker default): device=cuda, compute_type=float16.
# CPU-only machine: device=cpu, compute_type=int8 (the model loads lazily, so a
# wrong device only fails at the first transcription, not at startup).
# Model sizes: tiny/base/small are fast; medium is notably more accurate.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# Storage paths
CHROMA_PERSIST_DIR=./data/chroma
DOCS_DIR=./data/docs
# Temporary audio files are cleaned at startup and from the admin panel.
TMP_DIR=./data/tmp
# AI-generated markdown bundles are written here.
EXPORT_DIR=./data/exports
# Root for admin-settings.json and the generated token file.
DATA_DIR=./data

# Server settings
HOST=127.0.0.1
PORT=8765
# Docker publish interface. 127.0.0.1 = this machine only. To expose the panel
# and WebSocket to your Tailscale network, set it to the machine's Tailscale IP
# (`tailscale ip -4`, e.g. 100.115.199.119). Always keep API_TOKEN set.
BIND_ADDRESS=127.0.0.1
# Set API_TOKEN to a long random value when accessing the server from another machine.
# Set PRESENTATION_COPILOT_API_TOKEN to the same value on the Windows client.
# Leave empty for loopback-only access; Docker generates one on first run.
# scripts/bootstrap_env.py can create/rotate this value for you.
API_TOKEN=
MAX_AUDIO_SECONDS=90

# API token self-provisioning (Docker sets AUTO_GENERATE_TOKEN=true)
TOKEN_FILE=./data/.api-token
AUTO_GENERATE_TOKEN=false

# Remote admin panel
# Read-only bind mount of the server machine that the panel browses and ingests
# from. Docker maps ${HOST_DOCS_ROOT} here. Empty disables server-folder browsing.
HOST_MOUNT_ROOT=
ADMIN_SETTINGS_FILE=./data/admin-settings.json
EXPORT_RETENTION_DAYS=14
CLEANUP_ON_STARTUP=true

# Agent tool policy. Bash and agent ingestion are powerful; off by default.
AGENT_BASH_ENABLED=false
AGENT_INGEST_ENABLED=false
AGENT_MAX_ITERATIONS=3
# Repairs attempted when the answer review fails (0 = refuse immediately).
AGENT_MAX_REPAIRS=2
BASH_TIMEOUT_SECONDS=15
BASH_MAX_OUTPUT_CHARS=4000

# Audio settings
AUDIO_SAMPLE_RATE=16000
# Temporary file handed to Whisper: "m4a"/"ogg" encode Opus via ffmpeg, "wav" is
# lossless. The server falls back to WAV automatically if Opus is unavailable.
TRANSCRIPTION_AUDIO_FORMAT=m4a

# Live captions: periodically transcribe the rolling window while the client
# streams and push {"type":"caption"} so the HUD shows the question forming.
# Uses the accelerator continuously; togglable from the admin panel.
LIVE_CAPTION_ENABLED=false
LIVE_CAPTION_INTERVAL_SECONDS=2.5
LIVE_CAPTION_WINDOW_SECONDS=12

# A dedicated agent rewrites the raw transcript into ONE readable question
# (removes filler/repeats, fixes obvious ASR slips) before retrieval and answering.
QUESTION_NORMALIZER_ENABLED=true
# Optional separate model for the normalizer; empty uses OLLAMA_ANSWER_MODEL.
QUESTION_NORMALIZER_MODEL=

# Logging
LOG_LEVEL=INFO

