# Ollama LLM settings
OLLAMA_BASE_URL=http://localhost:11434
# Optional dedicated embedding endpoint; empty uses OLLAMA_BASE_URL.
OLLAMA_EMBEDDING_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b
# Adult audience; "plain" uses everyday words, "technical" keeps expert terminology.
RESPONSE_STYLE=plain

# Whisper STT settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Storage paths
CHROMA_PERSIST_DIR=./data/chroma
DOCS_DIR=./data/docs

# Server settings
HOST=127.0.0.1
PORT=8765
# Set API_TOKEN to a long random value when accessing the server from another machine.
# Set PRESENTATION_COPILOT_API_TOKEN to the same value on the Windows client.
API_TOKEN=
MAX_AUDIO_SECONDS=90

# Audio settings
AUDIO_SAMPLE_RATE=16000

# Logging
LOG_LEVEL=INFO

