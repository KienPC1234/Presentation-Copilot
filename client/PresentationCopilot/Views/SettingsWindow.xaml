<Window x:Class="PresentationCopilot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Presentation Copilot"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="500"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#BBBBCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5555AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7777CC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#333348"/>
                    <Setter Property="Foreground" Value="#8888AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Interactive hotkey field: click, then press a combination. -->
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#20222F"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#58A6FF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#2A2A3E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark dropdown for the audio device list. -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="#8899AA"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="260"
                                        Background="#20222F"
                                        BorderBrush="#44AAAAFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#DDDDEE"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33384D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D4A66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,18,0,2"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8888AA"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Presentation Copilot Settings"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextWrapping="NoWrap"
                   Margin="0,0,0,4"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
            <StackPanel>

                <!-- ── SERVER ─────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="SERVER" Margin="0,4,0,2"/>

                <Label Content="Server URI"/>
                <TextBox x:Name="TxtServerUri" Text="ws://localhost:8765"/>
                <TextBlock Text="ws://host:8765 on this machine, ws://192.168.x.x:8765 for a server on the network. Use wss:// whenever the API key crosses an untrusted network."/>

                <Label Content="API Key (API_TOKEN on the server)"/>
                <PasswordBox x:Name="TxtApiToken"/>
                <TextBlock Text="Leave empty for a local server started without a token. Stored as plain text in appsettings.json next to the app."/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnTest" Content="Test connection" Click="BtnTest_Click"/>
                    <TextBlock x:Name="TxtTestStatus"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Label Content="Presentation Topic (optional)"/>
                <TextBox x:Name="TxtTopic"/>
                <TextBlock Text="Product or thesis name. Helps the server find the right documents and keeps the context steady."/>

                <!-- ── HOTKEYS ────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="HOTKEYS"/>

                <Label Content="Ask for a suggestion (analyze)"/>
                <TextBox x:Name="TxtHotkey"
                         Style="{StaticResource HotkeyBox}"
                         Tag="analyze"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"/>
                <TextBlock Text="Click the box, then hold a modifier and press a key."/>

                <Label Content="Show / hide the HUD (also restores a hidden tray icon)"/>
                <TextBox x:Name="TxtToggleHotkey"
                         Style="{StaticResource HotkeyBox}"
                         Tag="toggle"
                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                         GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"/>

                <TextBlock x:Name="TxtHotkeyStatus" FontSize="11" Foreground="#7FB0FF"
                           Text="Press Esc while capturing to cancel. Windows-key combinations are not supported."/>

                <!-- ── AUDIO ──────────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="AUDIO"/>

                <Label Content="Audio source — system audio (loopback), a speaker, or a microphone"/>
                <ComboBox x:Name="CmbAudioDevice"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="#E6EDF3"
                                       FontSize="12"
                                       TextWrapping="NoWrap"
                                       Margin="0"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Pick the device the copilot should listen to. Loopback hears what your machine plays (works with headphones); choosing a specific speaker or microphone pins it to that device."/>

                <CheckBox x:Name="ChkStream" Content="Stream audio continuously while recording" Margin="0,12,0,0"/>
                <TextBlock Text="Keeps the server's rolling window current so a hotkey press only needs a trigger. Turn it off to send audio only when you press the hotkey."/>

                <CheckBox x:Name="ChkLiveCaptions" Content="Show live captions while listening" Margin="0,12,0,0"/>
                <TextBlock Text="Displays the question forming in the HUD while you speak, before you press the analyze hotkey."/>

                <Label Content="Analysis window (seconds)"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="SliderBuffer"
                            Minimum="5" Maximum="60" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Width="320"
                            ValueChanged="SliderBuffer_ValueChanged"/>
                    <TextBlock x:Name="TxtBufferValue"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="NoWrap"/>
                </StackPanel>

                <!-- ── APPEARANCE ─────────────────────────────────────── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="APPEARANCE"/>

                <Label Content="HUD opacity"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="SliderOpacity"
                            Minimum="0.2" Maximum="1.0" TickFrequency="0.05"
                            IsSnapToTickEnabled="True"
                            Width="320"
                            ValueChanged="SliderOpacity_ValueChanged"/>
                    <TextBlock x:Name="TxtOpacityValue"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="NoWrap"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="TxtVersion" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="NoWrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset defaults" Background="#333348" Margin="0,0,10,0" Click="BtnReset_Click"/>
                <Button Content="Cancel" Background="#333348" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Save" Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
