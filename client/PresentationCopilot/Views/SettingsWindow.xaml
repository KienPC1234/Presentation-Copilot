<Window x:Class="PresentationCopilot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — Presentation Copilot"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#BBBBCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#44AAAAFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5555AA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7777CC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,24">

        <TextBlock Text="Presentation Copilot Settings"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Server URI -->
        <Label Content="Server URI"/>
        <TextBox x:Name="TxtServerUri" Text="ws://localhost:8765"/>
        <TextBlock Text="ws://host:8765 for this machine, ws://192.168.x.x:8765 for a server on the network."
                   Foreground="#8888AA" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>

        <!-- API token -->
        <Label Content="API Key (API_TOKEN on the server)"/>
        <PasswordBox x:Name="TxtApiToken"/>
        <TextBlock Text="Leave empty for a local server started without a token. Required when the server has one."
                   Foreground="#8888AA" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>

        <!-- Presentation topic -->
        <Label Content="Presentation Topic (optional)"/>
        <TextBox x:Name="TxtTopic"/>
        <TextBlock Text="Product or thesis name. Helps the server find the right documents and keeps the context steady."
                   Foreground="#8888AA" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>

        <!-- Hotkey -->
        <Label Content="Global Hotkey (read-only — edit appsettings.json to change)"/>
        <TextBox x:Name="TxtHotkey" IsReadOnly="True" Opacity="0.6"/>

        <!-- Streaming -->
        <CheckBox x:Name="ChkStream" Content="Stream microphone/system audio continuously"/>

        <!-- Opacity -->
        <Label Content="HUD Opacity"/>
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="SliderOpacity"
                    Minimum="0.2" Maximum="1.0" TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    Width="300"
                    ValueChanged="SliderOpacity_ValueChanged"/>
            <TextBlock x:Name="TxtOpacityValue"
                       Foreground="#AAAACC"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Audio Buffer -->
        <Label Content="Audio Buffer / Analysis Window (seconds)"/>
        <StackPanel Orientation="Horizontal">
            <Slider x:Name="SliderBuffer"
                    Minimum="5" Maximum="60" TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Width="300"
                    ValueChanged="SliderBuffer_ValueChanged"/>
            <TextBlock x:Name="TxtBufferValue"
                       Foreground="#AAAACC"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Background="#333348" Margin="0,0,10,0"
                    Click="BtnCancel_Click"/>
            <Button Content="Save" Click="BtnSave_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
