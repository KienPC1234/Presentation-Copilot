<Window x:Class="PresentationCopilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Presentation Copilot"
        Width="1" Height="1"
        WindowStyle="None"
        ShowInTaskbar="True"
        Visibility="Hidden"
        AllowsTransparency="True"
        Background="Transparent">

    <Grid>
        <!-- System Tray Icon via Hardcodet.NotifyIcon.Wpf.
             LeftOrRightClick keeps both mouse buttons opening the menu, so the
             tray icon is easy to hit without knowing which button to use. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="Presentation Copilot — left or right click for the menu"
                        MenuActivation="LeftOrRightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show / Hide HUD"
                              Click="MenuShowHud_Click"
                              FontWeight="SemiBold"/>
                    <MenuItem Header="Pin / Unpin HUD (click-through)"
                              Click="MenuTogglePin_Click"/>
                    <Separator/>
                    <MenuItem Header="Settings…"
                              Click="MenuSettings_Click"/>
                    <Separator/>
                    <MenuItem Header="Hide tray icon (restore with the show/hide hotkey)"
                              Click="MenuHideTray_Click"/>
                    <MenuItem Header="Exit"
                              Click="MenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
